{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "strata",
  "main": ".open-next/worker.js",
  // `.open-next/` is generated and gitignored, so Wrangler must produce the
  // entry point itself before bundling. Without this, a clean checkout (such as
  // a Cloudflare Workers Build) fails with "entry-point file ... was not found".
  // Note: do not add `no_bundle` here — OpenNext's worker.js relies on Wrangler
  // to resolve its ./cloudflare/* and ./middleware/* imports.
  "build": {
    "command": "npm run build:worker"
  },
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "strata"
    }
  ],
  "routes": [
    {
      "pattern": "strata.abateiq.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strata",
      "database_id": "4e6bd4ce-5efe-4cbc-8be0-564efe23f2c1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "strata"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "strata-asbestos-compliance-opennext-cache"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
